# OpenAI-compatible endpoint. Hackathon server: http://10.10.10.10:4000/v1, model qwen3.8-27b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
# OpenRouter only: pin the provider (empty for the hackathon server)
LLM_PROVIDER=cerebras/fp16
LLM_API_KEY=
# Max parallel LLM calls (ключ организаторов: 3)
LLM_CONCURRENCY=3
# Tokens per minute limit of the key (ключ организаторов: 30000; 0 — узнать из ответов 429)
LLM_TPM=0
# auto | template | soft | none — как выключать «размышления» Qwen3 (см. DEPLOY.md)
LLM_THINKING=auto
# auto | off — просить ли у сервера JSON по схеме
LLM_STRUCTURED=auto
LLM_TIMEOUT=900
