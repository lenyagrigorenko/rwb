/// <summary>Пользователь системы (учётная запись с ролью).</summary>
public class AppUser
{
    public Guid Id { get; set; } = Guid.CreateVersion7();
    public string Login { get; set; } = "";
    public string DisplayName { get; set; } = "";
    public string Role { get; set; } = "";
    public string PasswordHash { get; set; } = "";
    public DateTimeOffset CreatedAt { get; set; }
}

/// <summary>Доменное событие в outbox: сохраняется в одной транзакции с изменением и публикуется в Kafka.</summary>
public class OutboxEvent
{
    public Guid Id { get; set; } = Guid.CreateVersion7();
    public string Type { get; set; } = "";
    public int Version { get; set; } = 1;
    public string Topic { get; set; } = "";
    public string? Key { get; set; }
    public Guid? EntityId { get; set; }
    public string Payload { get; set; } = "{}";
    public DateTimeOffset OccurredAt { get; set; }
    public DateTimeOffset? PublishedAt { get; set; }
    public int Attempts { get; set; }
}

/// <summary>Событие, полученное консьюмером из Kafka (идемпотентная обработка по EventId).</summary>
public class ConsumedEvent
{
    public Guid EventId { get; set; }
    public string Type { get; set; } = "";
    public string Topic { get; set; } = "";
    public int Partition { get; set; }
    public long Offset { get; set; }
    public string Payload { get; set; } = "{}";
    public DateTimeOffset ConsumedAt { get; set; }
}

/// <summary>Уведомление пользователю.</summary>
public class AppNotification
{
    public Guid Id { get; set; } = Guid.CreateVersion7();
    public Guid UserId { get; set; }
    public string Title { get; set; } = "";
    public string Body { get; set; } = "";
    public string EventType { get; set; } = "";
    public Guid? EventId { get; set; }
    public DateTimeOffset CreatedAt { get; set; }
    public DateTimeOffset? ReadAt { get; set; }
}

/// <summary>Сохранённый ответ на запрос с заголовком Idempotency-Key.</summary>
public class IdempotencyRecord
{
    public string Key { get; set; } = "";
    public int StatusCode { get; set; }
    public string Body { get; set; } = "";
    public DateTimeOffset CreatedAt { get; set; }
}
