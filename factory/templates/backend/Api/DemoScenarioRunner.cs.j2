// Сгенерировано фабрикой из IR: {{spec.slug}}
using System.Net.Http.Headers;
using System.Net.Http.Json;
using System.Text.Json;
using System.Text.Json.Nodes;
using Microsoft.EntityFrameworkCore;
using {{N}}.Api.Infrastructure;
using {{N}}.Application.Abstractions;
using {{N}}.Infrastructure;
using {{N}}.Infrastructure.Persistence;

namespace {{N}}.Api.Demo;

public sealed class DemoStepState
{
    public string Id { get; init; } = "";
    public string Title { get; init; } = "";
    public string Action { get; init; } = "";
    public string Status { get; set; } = "pending";
    public string? Detail { get; set; }
    public DateTimeOffset? At { get; set; }
}

public sealed class DemoExpectationException(string message) : InvalidOperationException(message);

public sealed record DemoStatus(string Title, bool Running, double ClockOffsetMinutes, IReadOnlyList<DemoStepState> Steps);

/// <summary>
/// Исполняет демонстрационный сценарий из требований через настоящий API (с аутентификацией ролей),
/// со сдвигом часов для событий, зависящих от времени. Шаги — Demo/demo.json (из IR).
/// </summary>
public sealed class DemoScenarioRunner(IServiceScopeFactory scopes, IHttpClientFactory httpFactory, DemoTimeProvider clock, JobRunner jobs, JwtTokenService tokens, ILogger<DemoScenarioRunner> log)
{
    private static readonly JsonObject Script = LoadScript();
    private readonly object _lock = new();
    private List<DemoStepState> _steps = NewSteps();
    private int _runs;
    private DateTimeOffset _timeBase;

    public bool Running { get; private set; }

    public DemoStatus Status
    {
        get
        {
            lock (_lock) return new DemoStatus(Script["title"]?.ToString() ?? "", Running, clock.Offset.TotalMinutes, _steps.ToList());
        }
    }

    public bool Start()
    {
        lock (_lock)
        {
            if (Running) return false;
            Running = true;
            _steps = NewSteps();
        }
        _ = Task.Run(RunAsync);
        return true;
    }

    private static JsonObject LoadScript()
    {
        using var stream = typeof(DemoScenarioRunner).Assembly.GetManifestResourceStream("demo.json")!;
        return JsonNode.Parse(stream)!.AsObject();
    }

    private static List<DemoStepState> NewSteps() =>
        (Script["steps"]?.AsArray() ?? new JsonArray()).Select(s => new DemoStepState
        {
            Id = s!["id"]!.ToString(),
            Title = s["title"]!.ToString(),
            Action = s["action"]!.ToString(),
        }).ToList();

    private async Task RunAsync()
    {
        var ct = CancellationToken.None;
        var vars = new Dictionary<string, string>();
        DemoRoute? route = null;
        try
        {
            if (Interlocked.Increment(ref _runs) > 1)
            {
                // Повторный прогон: сдвигаем часы, чтобы сессии прошлого прогона завершились.
                clock.Advance(TimeSpan.FromHours(3));
                await jobs.RunAllAsync(true, ct);
            }
            var since = clock.GetUtcNow().AddSeconds(-1);
            if (Script["timeBase"]?.GetValue<bool>() == true)
            {
                // Времена из сценария отсчитываются от ближайшей «круглой» отметки (шаг 15 мин) через час.
                var target = clock.GetUtcNow().AddMinutes(Script["timeBaseOffset"]?.GetValue<int>() ?? 60);
                var aligned = new DateTimeOffset(target.Ticks - target.Ticks % TimeSpan.FromMinutes(15).Ticks, TimeSpan.Zero).AddMinutes(15);
                clock.Advance(aligned - target);
                _timeBase = aligned;
            }
            var steps = Script["steps"]!.AsArray();
            for (var i = 0; i < steps.Count; i++)
            {
                var step = steps[i]!.AsObject();
                var state = _steps[i];
                state.Status = "running";
                state.At = clock.GetUtcNow();
                try
                {
                    switch (state.Action)
                    {
                        case "route":
                        {
                            using var scope = scopes.CreateScope();
                            var planner = scope.ServiceProvider.GetRequiredService<IDemoRoutePlanner>();
                            route ??= await planner.PlanAsync(step["layer"]?.ToString(), step["zones"]?.GetValue<int>() ?? 2, ct,
                                Guid.TryParse(step["targetVar"] is { } tv && vars.TryGetValue(tv.ToString(), out var tid) ? tid : null, out var g) ? g : null);
                            var leg = route.Legs[Math.Min(step["leg"]!.GetValue<int>(), route.Legs.Count - 1)];
                            var (client, userId) = await ClientAsync(step["login"]!.ToString(), ct);
                            var path = await ResolvePathAsync(step["path"]!.ToString(), userId, vars, ct, step["login"]?.ToString());
                            foreach (var p in leg)
                            {
                                var body = step["pointField"] is { } pf
                                    ? new JsonObject { [pf.ToString()] = new JsonObject { ["type"] = "Point", ["coordinates"] = new JsonArray(p.Lon, p.Lat) } }
                                    : new JsonObject { [step["latField"]!.ToString()] = p.Lat, [step["lonField"]!.ToString()] = p.Lon };
                                foreach (var (k, v) in step["extra"]?.AsObject() ?? new JsonObject()) body[k] = Special(v);
                                await SendAsync(client, step["method"]!.ToString(), path, body, ct);
                                await Task.Delay(TimeSpan.FromMilliseconds(900), ct);
                            }
                            state.Detail = $"Точек маршрута: {leg.Count}";
                            break;
                        }
                        case "operation":
                        {
                            var (client, userId) = await ClientAsync(step["login"]!.ToString(), ct);
                            var path = await ResolvePathAsync(step["path"]!.ToString(), userId, vars, ct, step["login"]?.ToString());
                            var args = step["args"]?.DeepClone()?.AsObject() ?? new JsonObject();
                            foreach (var key in args.Select(kv => kv.Key).ToList()) args[key] = Special(args[key]);
                            await ResolveArgsAsync(args, step["resolve"]?.AsObject(), userId, vars, ct, step["login"]?.ToString());
                            await ResolvePlaceholderIdsAsync(args, userId, vars, ct);
                            if (step["expectError"]?.GetValue<bool>() == true)
                            {
                                try
                                {
                                    await SendAsync(client, step["method"]!.ToString(), path, args, ct);
                                    throw new DemoExpectationException("Ожидался отказ, но операция выполнена");
                                }
                                catch (InvalidOperationException ex) when (ex is not DemoExpectationException && ex.Message.Contains(": 4", StringComparison.Ordinal))
                                {
                                    var title = System.Text.RegularExpressions.Regex.Match(ex.Message, "\"title\":\"([^\"]+)\"").Groups[1].Value;
                                    state.Detail = $"Отказ, как и ожидалось: {title}";
                                }
                                break;
                            }
                            var result = await SendAsync(client, step["method"]!.ToString(), path, args, ct);
                            // Поиск вернул список («найти свободный слот») — первая найденная запись становится текущей.
                            var found = result is JsonArray list && list.Count > 0 ? list[0] as JsonObject
                                : result is JsonObject page && page["items"] is JsonArray items && items.Count > 0 ? items[0] as JsonObject : null;
                            if (found?["id"] is { } foundId && step["outputVar"] is { } listVar) vars[listVar.ToString()] = foundId.ToString();
                            if (result is JsonObject created && created["id"] is { } newId && step["thenTransitions"] is JsonArray chain)
                            {
                                // Запись создана в начальном статусе — переводим в статус, который задан в сценарии.
                                foreach (var t in chain)
                                {
                                    var (tc, _) = await ClientAsync(t!["login"]!.ToString(), ct);
                                    result = await SendAsync(tc, "POST", t["path"]!.ToString().Replace("{id}", newId.ToString()), new JsonObject(), ct) ?? result;
                                }
                            }
                            if (result is JsonObject ro && ro["id"] is { } id && step["outputVar"] is { } outVar)
                            {
                                // Запись «своя» для пользователя шага; операция над существующей записью не меняет «последнюю созданную».
                                vars[$"{outVar}@{step["login"]}"] = id.ToString();
                                if (step["updatesExisting"]?.GetValue<bool>() != true) vars[outVar.ToString()] = id.ToString();
                            }
                            state.Detail = Summarize(result);
                            break;
                        }
                        case "view":
                        {
                            var (client, _) = await ClientAsync(step["login"]!.ToString(), ct);
                            var page = await SendAsync(client, "GET", step["path"]!.ToString(), new JsonObject { ["pageSize"] = 5 }, ct);
                            state.Detail = $"Записей: {(page is JsonObject po ? po["total"]?.ToString() ?? "—" : "—")}";
                            break;
                        }
                        case "transition":
                        {
                            var (client, userId) = await ClientAsync(step["login"]!.ToString(), ct);
                            var path = await ResolvePathAsync(step["path"]!.ToString(), userId, vars, ct, step["login"]?.ToString());
                            var result = await SendAsync(client, "POST", path, new JsonObject(), ct);
                            state.Detail = Summarize(result);
                            break;
                        }
                        case "advance_time":
                        {
                            var minutes = step["minutes"]?.GetValue<int>() ?? 0;
                            var jumped = step["jumpTo"] is JsonObject jump ? await JumpToAsync(jump, vars, ct) : null;
                            if (jumped is null) clock.Advance(TimeSpan.FromMinutes(minutes));
                            await jobs.RunAllAsync(true, ct);
                            state.Detail = jumped ?? $"Часы сдвинуты на {minutes} мин";
                            break;
                        }
                        case "expect":
                        {
                            var type = step["event"]!.ToString();
                            state.Detail = await WaitEventAsync(type, since, ct) ?? throw new InvalidOperationException($"Событие {type} не получено");
                            break;
                        }
                    }
                    state.Status = "done";
                }
                catch (Exception ex)
                {
                    state.Status = "failed";
                    state.Detail = ex.Message;
                    log.LogWarning(ex, "Demo step {Step} failed", state.Id);
                }
            }
        }
        finally
        {
            Running = false;
        }
    }

    /// <summary>Значения-заглушки сценария: $now — текущее время приложения, $today — текущая дата.</summary>
    private JsonNode? Special(JsonNode? value) => value?.ToString() switch
    {
        "$now" => JsonValue.Create(clock.GetUtcNow().ToString("O")),
        "$today" => JsonValue.Create(AppTime.ToLocal(clock.GetUtcNow()).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)),
        _ => value?.DeepClone(),
    };

    private async Task<string?> WaitEventAsync(string type, DateTimeOffset since, CancellationToken ct)
    {
        for (var attempt = 0; attempt < 16; attempt++)
        {
            using var scope = scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var ev = await db.OutboxEvents.AsNoTracking().Where(x => x.Type == type && x.OccurredAt >= since).OrderByDescending(x => x.OccurredAt).FirstOrDefaultAsync(ct);
            if (ev is not null)
            {
                var text = await db.Notifications.AsNoTracking().Where(n => n.EventId == ev.Id).Select(n => n.Body).FirstOrDefaultAsync(ct);
                return text ?? $"{ev.Type}: {ev.Payload}";
            }
            await Task.Delay(TimeSpan.FromMilliseconds(500), ct);
        }
        return null;
    }

    private async Task<(HttpClient Client, Guid UserId)> ClientAsync(string login, CancellationToken ct)
    {
        using var scope = scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var user = await db.Users.AsNoTracking().FirstAsync(x => x.Login == login, ct);
        var client = httpFactory.CreateClient("self");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", tokens.Issue(user).Token);
        return (client, user.Id);
    }

    private static async Task<JsonNode?> SendAsync(HttpClient client, string method, string path, JsonObject args, CancellationToken ct)
    {
        HttpResponseMessage response;
        if (method == "GET")
        {
            var query = string.Join("&", args.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value?.ToString() ?? "")}"));
            response = await client.GetAsync(query.Length > 0 ? $"{path}?{query}" : path, ct);
        }
        else
        {
            var request = new HttpRequestMessage(new HttpMethod(method), path) { Content = JsonContent.Create(args) };
            request.Headers.Add("Idempotency-Key", Guid.NewGuid().ToString());
            response = await client.SendAsync(request, ct);
        }
        var text = await response.Content.ReadAsStringAsync(ct);
        if (!response.IsSuccessStatusCode) throw new InvalidOperationException($"{method} {path}: {(int)response.StatusCode} {text}");
        return text.Length == 0 ? null : JsonNode.Parse(text);
    }

    private static string Summarize(JsonNode? node)
    {
        if (node is not JsonObject obj) return "OK";
        return string.Join(", ", obj.Where(kv => kv.Value is JsonValue && kv.Key != "id" && !Guid.TryParse(kv.Value!.ToString(), out _))
            .Take(4).Select(kv => $"{kv.Key}: {kv.Value}"));
    }

    /// <summary>Перед проверкой напоминания часы переводятся внутрь окна напоминания до времени записи.</summary>
    private async Task<string?> JumpToAsync(JsonObject jump, Dictionary<string, string> vars, CancellationToken ct)
    {
        if (!vars.TryGetValue(jump["var"]!.ToString(), out var raw) || !Guid.TryParse(raw, out var id)) return null;
        using var scope = scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        await db.Database.OpenConnectionAsync(ct);
        try
        {
            await using var cmd = new Npgsql.NpgsqlCommand(jump["sql"]!.ToString(), (Npgsql.NpgsqlConnection)db.Database.GetDbConnection());
            cmd.Parameters.AddWithValue("id", id);
            DateTimeOffset? at = await cmd.ExecuteScalarAsync(ct) switch
            {
                DateTimeOffset d => d,
                DateTime d => new DateTimeOffset(DateTime.SpecifyKind(d, DateTimeKind.Utc)),
                _ => null,
            };
            if (at is not { } time) return null;
            var lead = jump["leadMinutes"]?.GetValue<int>() ?? 60;
            var now = clock.GetUtcNow();
            var target = time.AddMinutes(-lead);
            if (target <= now) return null;
            clock.Advance(target - now);
            return $"Часы переведены на {AppTime.Hm(target)} {target:dd.MM}: до времени записи ({AppTime.Hm(time)}) {lead} мин";
        }
        finally
        {
            await db.Database.CloseConnectionAsync();
        }
    }

    private async Task<string> ResolvePathAsync(string template, Guid userId, Dictionary<string, string> vars, CancellationToken ct, string? login = null)
    {
        var path = template;
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(template, @"\{(\w+)\}"))
        {
            var name = m.Groups[1].Value;
            // Сначала запись, созданная этим же пользователем («первый участник отменяет свою регистрацию»).
            if (!(login is not null && vars.TryGetValue($"{name}@{login}", out var value)) && !vars.TryGetValue(name, out value))
            {
                // {requestId} может ссылаться на переменную maintenanceRequestId (имя сущности длиннее параметра).
                value = vars.FirstOrDefault(kv => kv.Key.EndsWith(name, StringComparison.OrdinalIgnoreCase)
                                                  || kv.Key.EndsWith(char.ToUpperInvariant(name[0]) + name[1..], StringComparison.Ordinal)).Value;
            }
            if (value is null)
            {
                value = (await ResolveParamAsync(name, userId, ct))?.ToString() ?? throw new InvalidOperationException($"Не найдено значение параметра {name}");
                vars[name] = value;
            }
            path = path.Replace(m.Value, value, StringComparison.Ordinal);
        }
        return path;
    }

    /// <summary>Условные id в любом месте тела («prod-1» в позициях заказа) — реальные id записей той же сущности.</summary>
    private async Task ResolvePlaceholderIdsAsync(JsonNode? node, Guid userId, Dictionary<string, string> vars, CancellationToken ct)
    {
        switch (node)
        {
            case JsonObject obj:
                foreach (var key in obj.Select(kv => kv.Key).ToList())
                {
                    var value = obj[key];
                    if (key.EndsWith("Id", StringComparison.Ordinal) && value is JsonValue v && v.TryGetValue<string>(out var s)
                        && !Guid.TryParse(s, out _) && !string.IsNullOrWhiteSpace(s))
                    {
                        var id = vars.TryGetValue(key, out var known) ? known : (await ResolveParamAsync(key, userId, ct))?.ToString();
                        if (id is not null) obj[key] = id;
                    }
                    else
                    {
                        await ResolvePlaceholderIdsAsync(value, userId, vars, ct);
                    }
                }
                break;
            case JsonArray arr:
                foreach (var item in arr) await ResolvePlaceholderIdsAsync(item, userId, vars, ct);
                break;
        }
    }

    /// <summary>Заменяет условные значения аргументов демо-шага реальными: id записей, пользователей, координаты объекта.</summary>
    private async Task ResolveArgsAsync(JsonObject args, JsonObject? resolve, Guid userId, Dictionary<string, string> vars, CancellationToken ct, string? actor = null)
    {
        if (resolve is null) return;
        foreach (var (key, spec) in resolve)
        {
            var kind = spec?["kind"]?.ToString();
            switch (kind)
            {
                case "entity":
                {
                    var name = spec!["var"]!.ToString();
                    var nth = spec["nth"]?.GetValue<int>() ?? 0;
                    string? id;
                    if (nth > 0)
                    {
                        // Вторая ссылка на ту же сущность в одном шаге: другая запись, не та, что уже подставлена.
                        var used = args.Select(kv => kv.Value?.ToString()).ToHashSet();
                        id = null;
                        for (var k = nth; k < nth + 5 && id is null; k++)
                        {
                            var candidate = (await ResolveParamAsync(name, userId, ct, k))?.ToString();
                            if (candidate is null) break;
                            if (!used.Contains(candidate)) id = candidate;
                        }
                        id ??= "";
                    }
                    else if (!(actor is not null && vars.TryGetValue($"{name}@{actor}", out id)) && !vars.TryGetValue(name, out id))
                    {
                        id = (await ResolveParamAsync(name, userId, ct))?.ToString() ?? "";
                        if (id.Length > 0) vars[name] = id;
                    }
                    if (id.Length > 0) args[key] = id;
                    break;
                }
                case "user":
                {
                    using var scope = scopes.CreateScope();
                    var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                    var login = spec!["login"]!.ToString();
                    var user = await db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Login == login, ct);
                    if (user is not null) args[key] = user.Id.ToString();
                    break;
                }
                case "time":
                {
                    var offset = spec!["offsetMinutes"]!.GetValue<int>();
                    args[key] = _timeBase.AddMinutes(offset).ToString("O");
                    break;
                }
                case "date":
                {
                    // Отдельные дата и время в сценарии понимаются как местное время (Europe/Moscow).
                    var local = AppTime.ToLocal(_timeBase).Date.AddMinutes(spec!["offsetMinutes"]!.GetValue<int>());
                    args[key] = local.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
                    break;
                }
                case "clock":
                {
                    var local = AppTime.ToLocal(_timeBase).AddMinutes(spec!["offsetMinutes"]!.GetValue<int>());
                    args[key] = local.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);
                    break;
                }
                case "field":
                {
                    // Значение, которое сгенерировала система (код, номер), — из записи, созданной ранее в сценарии.
                    if (!vars.TryGetValue(spec!["var"]!.ToString(), out var rid)) break;
                    var (admin, _) = await ClientAsync(Script["adminLogin"]?.ToString() ?? "", ct);
                    var record = await SendAsync(admin, "GET", spec["path"]!.ToString().Replace("{" + spec["var"]!.ToString() + "}", rid), new JsonObject(), ct);
                    if (record is JsonObject rec && rec[spec["field"]!.ToString()] is { } value) args[key] = value.DeepClone();
                    break;
                }
                case "zonepoint":
                {
                    // Точка внутри зоны геослоя (или далеко за её пределами для шага-отказа).
                    using var scope = scopes.CreateScope();
                    var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                    await db.Database.OpenConnectionAsync(ct);
                    try
                    {
                        await using var cmd = new Npgsql.NpgsqlCommand(spec!["sql"]!.ToString(), (Npgsql.NpgsqlConnection)db.Database.GetDbConnection());
                        await using var reader = await cmd.ExecuteReaderAsync(ct);
                        if (await reader.ReadAsync(ct) && !reader.IsDBNull(0))
                        {
                            var (lat, lon) = (reader.GetDouble(0), reader.GetDouble(1));
                            if (spec["outside"]?.GetValue<bool>() == true) (lat, lon) = (lat + 0.35, lon + 0.5);
                            args[key] = spec["shape"]?.ToString() == "latlon"
                                ? new JsonObject { ["lat"] = lat, ["lon"] = lon }
                                : new JsonObject { ["type"] = "Point", ["coordinates"] = new JsonArray(lon, lat) };
                        }
                    }
                    finally
                    {
                        await db.Database.CloseConnectionAsync();
                    }
                    break;
                }
                case "geo":
                {
                    if (!vars.TryGetValue(spec!["var"]!.ToString(), out var id) || !Guid.TryParse(id, out var gid)) break;
                    using var scope = scopes.CreateScope();
                    var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                    await db.Database.OpenConnectionAsync(ct);
                    try
                    {
                        await using var cmd = new Npgsql.NpgsqlCommand(spec["sql"]!.ToString(), (Npgsql.NpgsqlConnection)db.Database.GetDbConnection());
                        cmd.Parameters.AddWithValue("id", gid);
                        await using var reader = await cmd.ExecuteReaderAsync(ct);
                        if (await reader.ReadAsync(ct) && !reader.IsDBNull(0))
                            args[key] = spec["coord"]!.ToString() == "lat" ? reader.GetDouble(0) : reader.GetDouble(1);
                    }
                    finally
                    {
                        await db.Database.CloseConnectionAsync();
                    }
                    break;
                }
            }
        }
    }

    /// <summary>Значение параметра пути: запись сущности, принадлежащая пользователю (или любая); nth — порядковый номер.</summary>
    private async Task<Guid?> ResolveParamAsync(string name, Guid userId, CancellationToken ct, int nth = 0)
    {
        var now = clock.GetUtcNow();
        using var scope = scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        switch (name)
        {
{% for e in spec.entities %}
{% for alias in id_aliases(e) %}
            case "{{alias}}":
{% endfor %}
{# Запись человека (сотрудник, врач) — по его учётной записи: «сотрудник подаёт заявку» от своего имени. #}
{% set owners = owner_fields(e) or (e.fields | selectattr("name", "equalto", "userId") | selectattr("ref", "equalto", "User") | map(attribute="name") | list) %}
{% set up = upcoming_field(e) if upcoming_field is defined else none %}
{% set order %}{% if up %}OrderBy(x => x.{{pascal(up.name)}} < now ? 1 : 0).ThenBy(x => x.CreatedAt){% else %}OrderBy(x => x.CreatedAt){% endif %}.ThenBy(x => x.Id){% endset %}
{% if owners %}
                return await db.{{plural(e.name)}}.AsNoTracking().Where(x => {% for f in owners %}x.{{pascal(f)}} == userId{% if not loop.last %} || {% endif %}{% endfor %}).{{order}}.Skip(nth).Select(x => (Guid?)x.Id).FirstOrDefaultAsync(ct)
                    ?? await db.{{plural(e.name)}}.AsNoTracking().{{order}}.Skip(nth).Select(x => (Guid?)x.Id).FirstOrDefaultAsync(ct);
{% else %}
                return await db.{{plural(e.name)}}.AsNoTracking().{{order}}.Skip(nth).Select(x => (Guid?)x.Id).FirstOrDefaultAsync(ct);
{% endif %}
{% endfor %}
            default:
                return null;
        }
    }
}
