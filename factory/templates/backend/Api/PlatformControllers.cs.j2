public sealed record LoginRequest(string Login, string Password);

public sealed record UserDto(Guid Id, string Login, string DisplayName, string Role);

public sealed record LoginResponse(string Token, DateTimeOffset ExpiresAt, UserDto User);

public sealed record DemoUserDto(string Login, string Role, string DisplayName);

/// <summary>Аутентификация.</summary>
[ApiController]
[Route("api/v1/auth")]
[Tags("Аутентификация")]
public sealed class AuthController(IAppDbContext db, JwtTokenService tokens, IPasswordHasher<AppUser> hasher, ICurrentUser current) : ControllerBase
{
    /// <summary>Вход по логину и паролю, возвращает JWT.</summary>
    [HttpPost("login")]
    [AllowAnonymous]
    [EnableRateLimiting("login")]
    public async Task<LoginResponse> Login(LoginRequest request, CancellationToken ct)
    {
        var user = await db.Users.FirstOrDefaultAsync(x => x.Login == request.Login, ct);
        if (user is null || hasher.VerifyHashedPassword(user, user.PasswordHash, request.Password) == PasswordVerificationResult.Failed)
            throw new AppException("Неверный логин или пароль", 401, "invalid_credentials");
        var (token, expires) = tokens.Issue(user);
        return new LoginResponse(token, expires, new UserDto(user.Id, user.Login, user.DisplayName, user.Role));
    }

    /// <summary>Текущий пользователь.</summary>
    [HttpGet("me")]
    [Authorize]
    public async Task<UserDto> Me(CancellationToken ct)
    {
        var id = current.RequireUserId();
        var user = await db.Users.FirstOrDefaultAsync(x => x.Id == id, ct) ?? throw new NotFoundException("Пользователь не найден");
        return new UserDto(user.Id, user.Login, user.DisplayName, user.Role);
    }

    /// <summary>Демо-учётные записи (логины и роли, без паролей) для экрана входа.</summary>
    [HttpGet("demo-users")]
    [AllowAnonymous]
    public async Task<IReadOnlyList<DemoUserDto>> DemoUsers(CancellationToken ct) =>
        await db.Users.OrderBy(x => x.Login).Select(x => new DemoUserDto(x.Login, x.Role, x.DisplayName)).ToListAsync(ct);
}

/// <summary>Пользователи (для выбора в формах).</summary>
[ApiController]
[Authorize(Roles = "{{ admin_roles | join(',') }}")]
[Route("api/v1/users")]
[Tags("Пользователи")]
public sealed class UsersController(IAppDbContext db) : ControllerBase
{
    [HttpGet]
    public async Task<IReadOnlyList<UserDto>> List([FromQuery] string? role, CancellationToken ct) =>
        await db.Users.AsNoTracking().Where(x => role == null || x.Role == role).OrderBy(x => x.DisplayName)
