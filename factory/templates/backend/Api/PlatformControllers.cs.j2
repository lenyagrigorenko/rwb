}

public sealed record NotificationDto(Guid Id, string Title, string Body, string EventType, DateTimeOffset CreatedAt, DateTimeOffset? ReadAt);

/// <summary>Уведомления текущего пользователя.</summary>
[ApiController]
[Authorize]
[Route("api/v1/me/notifications")]
[Tags("Уведомления")]
public sealed class NotificationsController(IAppDbContext db, ICurrentUser current, TimeProvider clock) : ControllerBase
{
    /// <summary>Последние уведомления (since — только новее указанного момента).</summary>
    [HttpGet]
    public async Task<IReadOnlyList<NotificationDto>> List([FromQuery] DateTimeOffset? since, CancellationToken ct)
    {
        var id = current.RequireUserId();
        var q = db.Notifications.AsNoTracking().Where(x => x.UserId == id);
        if (since is not null) q = q.Where(x => x.CreatedAt > since.Value.ToUniversalTime());
        return await q.OrderByDescending(x => x.CreatedAt).Take(50)
            .Select(x => new NotificationDto(x.Id, x.Title, x.Body, x.EventType, x.CreatedAt, x.ReadAt)).ToListAsync(ct);
    }

    /// <summary>Отметить уведомление прочитанным.</summary>
    [HttpPost("{id:guid}/read")]
    public async Task<IActionResult> Read(Guid id, CancellationToken ct)
    {
        var uid = current.RequireUserId();
        var n = await db.Notifications.FirstOrDefaultAsync(x => x.Id == id && x.UserId == uid, ct) ?? throw new NotFoundException("Уведомление не найдено");
        n.ReadAt = clock.GetUtcNow();
        await db.SaveChangesAsync(ct);
        return NoContent();
    }
}

public sealed record EventDto(Guid Id, string Type, int Version, string Topic, string? Key, Guid? EntityId, JsonElement Payload, DateTimeOffset OccurredAt, DateTimeOffset? PublishedAt, bool Consumed);

/// <summary>Журнал доменных событий (outbox) и подтверждения обработки из Kafka.</summary>
[ApiController]
[Authorize(Roles = "{{ admin_roles | join(',') }}")]
[Route("api/v1/events")]
[Tags("События")]
public sealed class EventsController(IAppDbContext db) : ControllerBase
{
    /// <summary>События по убыванию времени; фильтры type и entityId.</summary>
    [HttpGet]
    public async Task<PagedResult<EventDto>> List([FromQuery] ListQuery query, [FromQuery] string? type, [FromQuery] Guid? entityId, CancellationToken ct)
    {
        var q = db.OutboxEvents.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(type)) q = q.Where(x => x.Type == type);
        if (entityId is not null) q = q.Where(x => x.EntityId == entityId);
        var page = Math.Max(1, query.Page);
        var size = Math.Clamp(query.PageSize, 1, 200);
        var total = await q.CountAsync(ct);
        var rows = await q.OrderByDescending(x => x.OccurredAt).Skip((page - 1) * size).Take(size).ToListAsync(ct);
        var ids = rows.Select(r => r.Id).ToList();
        var consumed = await db.ConsumedEvents.AsNoTracking().Where(c => ids.Contains(c.EventId)).Select(c => c.EventId).ToListAsync(ct);
        var items = rows.Select(r => new EventDto(r.Id, r.Type, r.Version, r.Topic, r.Key, r.EntityId,
            JsonDocument.Parse(r.Payload).RootElement.Clone(), r.OccurredAt, r.PublishedAt, consumed.Contains(r.Id))).ToList();
        return new PagedResult<EventDto>(items, total, page, size);
    }
}

