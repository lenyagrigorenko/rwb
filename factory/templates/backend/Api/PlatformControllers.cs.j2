public sealed record ClockRequest(int Minutes);

/// <summary>Демонстрационный режим: сценарий из требований и управление часами.</summary>
[ApiController]
[Authorize(Roles = "{{ admin_roles | join(',') }}")]
[Route("api/v1/demo")]
[Tags("Демо-режим")]
public sealed class DemoController(DemoScenarioRunner runner, DemoTimeProvider clock, JobRunner jobs) : ControllerBase
{
    /// <summary>Шаги сценария и их состояние.</summary>
    [HttpGet]
    public DemoStatus Get() => runner.Status;

    /// <summary>Запустить сценарий (асинхронно).</summary>
    [HttpPost("run")]
    [ProducesResponseType(StatusCodes.Status202Accepted)]
    public IActionResult Run() => runner.Start() ? Accepted(runner.Status) : Conflict(runner.Status);

    /// <summary>Сдвинуть часы приложения вперёд и выполнить фоновые задачи.</summary>
    [HttpPost("clock")]
    public async Task<object> Advance(ClockRequest request, CancellationToken ct)
    {
        clock.Advance(TimeSpan.FromMinutes(Math.Clamp(request.Minutes, 1, 24 * 60)));
        await jobs.RunAllAsync(true, ct);
        return new { now = clock.GetUtcNow(), offsetMinutes = clock.Offset.TotalMinutes };
    }

    /// <summary>Сбросить сдвиг часов.</summary>
    [HttpPost("clock/reset")]
    public object Reset()
    {
        clock.Reset();
        return new { now = clock.GetUtcNow(), offsetMinutes = 0 };
    }
}
