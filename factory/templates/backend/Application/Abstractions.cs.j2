/// <summary>Преобразования геометрии в GeoJSON и обратно.</summary>
public static class GeoJson
{
    public static readonly JsonSerializerOptions Options = CreateOptions();

    private static JsonSerializerOptions CreateOptions()
    {
        var o = new JsonSerializerOptions(JsonSerializerDefaults.Web);
        o.Converters.Add(new GeoJsonConverterFactory());
        return o;
    }

    public static JsonElement? ToJson(Geometry? g) => g is null ? null : JsonSerializer.SerializeToElement(g, Options);

    public static Geometry? FromJson(JsonElement? json)
    {
        if (json is null || json.Value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined) return null;
        var g = json.Value.Deserialize<Geometry>(Options);
        if (g is not null) g.SRID = 4326;
        return g;
    }

    public static Point Point(double lon, double lat) => new(lon, lat) { SRID = 4326 };

    public static JsonElement? Raw(string? json) => json is null ? null : JsonDocument.Parse(json).RootElement.Clone();
}

/// <summary>Местное время пользователей (Europe/Moscow; при отсутствии tzdata — фиксированный UTC+3).</summary>
public static class AppTime
{
    private static readonly TimeZoneInfo Zone = Resolve();

    private static TimeZoneInfo Resolve()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Europe/Moscow"); }
        catch (TimeZoneNotFoundException) { return TimeZoneInfo.CreateCustomTimeZone("MSK", TimeSpan.FromHours(3), "MSK", "MSK"); }
    }

    public static DateTimeOffset ToLocal(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, Zone);

    /// <summary>Время в формате ЧЧ:ММ по местному времени.</summary>
    public static string Hm(DateTimeOffset utc) => ToLocal(utc).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);
}

