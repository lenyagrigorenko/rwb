namespace {{N}}.Application.Common;

/// <summary>Ошибка прикладного уровня, преобразуется в ProblemDetails (RFC 9457).</summary>
public class AppException(string message, int status, string code) : Exception(message)
{
    public int Status { get; } = status;
    public string Code { get; } = code;
}

public sealed class NotFoundException(string message) : AppException(message, 404, "not_found");

public sealed class ForbiddenException(string message = "Недостаточно прав для выполнения операции")
    : AppException(message, 403, "forbidden");

public sealed class ConflictException(string message) : AppException(message, 409, "conflict");

/// <summary>Нарушение бизнес-правила (запрос корректен, но операция недопустима).</summary>
public sealed class BusinessRuleException(string message) : AppException(message, 422, "business_rule");

public sealed class ValidationException(IDictionary<string, string[]> errors, string message = "Ошибка валидации")
    : AppException(message, 400, "validation")
{
    public IDictionary<string, string[]> Errors { get; } = errors;

    public static ValidationException For(string field, string error) =>
        new(new Dictionary<string, string[]> { [field] = [error] });
}

/// <summary>Страница результатов.</summary>
public sealed record PagedResult<T>(IReadOnlyList<T> Items, int Total, int Page, int PageSize);

/// <summary>Параметры списка: пагинация, сортировка, поиск.</summary>
public sealed class ListQuery
{
    public int Page { get; set; } = 1;
    public int PageSize { get; set; } = 20;
    public string? Sort { get; set; }
    public string? Dir { get; set; }
    public string? Q { get; set; }
}

/// <summary>Матрица прав доступа ролей к сущностям (из IR).</summary>
public static class Permissions
{
    private static readonly Dictionary<(string Role, string Entity), string[]> Matrix = new()
    {
{% for p in spec.permissions %}
        [("{{p.role}}", "{{p.entity}}")] = [{% for a in p.actions %}"{{a}}"{% if not loop.last %}, {% endif %}{% endfor %}],
{% endfor %}
    };

    public static readonly string[] Roles = [{% for r in spec.roles %}"{{r.name}}"{% if not loop.last %}, {% endif %}{% endfor %}];

    public static bool Can(string? role, string entity, string action) =>
        role is not null && Matrix.TryGetValue((role, entity), out var actions) && actions.Contains(action);
}

/// <summary>Номер записи для системных полей: ПРЕФИКС-ГГММДД-NNN (ограничен длиной поля).</summary>
public static class AutoNumber
{
    public static string Next(string prefix, int maxLength)
    {
        var value = $"{prefix}-{DateTime.UtcNow:yyMMdd}-{Random.Shared.Next(100, 1000)}";
        return value.Length <= maxLength ? value : value[^maxLength..];
    }
}

/// <summary>Счётчики для /metrics в формате Prometheus: HTTP-запросы, бизнес-операции, доменные события.</summary>
public static class AppMetrics
{
    private static readonly double[] Buckets = [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10];
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<(string Name, string Labels), long> Counters = new();
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<(string Name, string Labels), Histogram> Histograms = new();

    public static string Label(string name, string value) => $"{name}=\"{value.Replace("\\", "\\\\").Replace("\"", "\\\"")}\"";

    public static void Inc(string name, string labels = "", long by = 1) => Counters.AddOrUpdate((name, labels), by, (_, v) => v + by);

    public static void Observe(string name, string labels, double seconds) =>
        Histograms.GetOrAdd((name, labels), _ => new Histogram()).Observe(seconds);

    /// <summary>Текст для /metrics; gauges — дополнительные значения (имя → значение), вычисленные при запросе.</summary>
    public static string Render(IEnumerable<(string Name, string Help, string Type, string Labels, double Value)> gauges)
    {
        var sb = new System.Text.StringBuilder();
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        foreach (var group in Counters.GroupBy(kv => kv.Key.Name).OrderBy(g => g.Key))
        {
            sb.Append("# TYPE ").Append(group.Key).Append(" counter\n");
            foreach (var kv in group) sb.Append(group.Key).Append('{').Append(kv.Key.Labels).Append("} ").Append(kv.Value.ToString(inv)).Append('\n');
        }
        foreach (var group in Histograms.GroupBy(kv => kv.Key.Name).OrderBy(g => g.Key))
        {
            sb.Append("# TYPE ").Append(group.Key).Append(" histogram\n");
            foreach (var kv in group)
            {
                var (counts, sum, count) = kv.Value.Snapshot();
                var sep = kv.Key.Labels.Length > 0 ? "," : "";
                long cumulative = 0;
                for (var i = 0; i < Buckets.Length; i++)
                {
                    cumulative += counts[i];
                    sb.Append(group.Key).Append("_bucket{").Append(kv.Key.Labels).Append(sep).Append("le=\"").Append(Buckets[i].ToString(inv)).Append("\"} ").Append(cumulative.ToString(inv)).Append('\n');
                }
                sb.Append(group.Key).Append("_bucket{").Append(kv.Key.Labels).Append(sep).Append("le=\"+Inf\"} ").Append(count.ToString(inv)).Append('\n');
                sb.Append(group.Key).Append("_sum{").Append(kv.Key.Labels).Append("} ").Append(sum.ToString(inv)).Append('\n');
                sb.Append(group.Key).Append("_count{").Append(kv.Key.Labels).Append("} ").Append(count.ToString(inv)).Append('\n');
            }
        }
        foreach (var g in gauges)
        {
            sb.Append("# HELP ").Append(g.Name).Append(' ').Append(g.Help).Append('\n');
            sb.Append("# TYPE ").Append(g.Name).Append(' ').Append(g.Type).Append('\n');
            sb.Append(g.Name).Append(g.Labels.Length > 0 ? "{" + g.Labels + "}" : "").Append(' ').Append(g.Value.ToString(inv)).Append('\n');
        }
        return sb.ToString();
    }

    private sealed class Histogram
    {
        private readonly long[] _counts = new long[Buckets.Length];
        private double _sum;
        private long _count;

        public void Observe(double value)
        {
            lock (this)
            {
                var i = Array.FindIndex(Buckets, b => value <= b);
                if (i >= 0) _counts[i]++;
                _sum += value;
                _count++;
            }
        }

        public (long[] Counts, double Sum, long Count) Snapshot()
        {
            lock (this) return ((long[])_counts.Clone(), _sum, _count);
        }
    }
}
