<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>{{N}}.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" />
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../{{N}}.Application/{{N}}.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
    <EmbeddedResource Include="Persistence/seed.json" LogicalName="seed.json" />
  </ItemGroup>
</Project>
