# Скопируйте в .env и при необходимости измените. Реальные секреты в репозиторий не коммитятся.
# Пароль локальной БД (используется только внутри docker compose)
DB_PASSWORD=app-local-dev
# Ключ подписи JWT, не короче 32 символов. Пусто — сгенерируется случайный при каждом старте.
JWT_KEY=
# Пароль демо-пользователей ({{ spec.roles | map(attribute='demo_login') | join(', ') }})
DEMO_PASSWORD=Demo2026!
# Порты на хосте
WEB_PORT=8088
API_PORT=8080
DB_PORT=5432
MOCKS_PORT=8081
